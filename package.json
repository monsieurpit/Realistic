{
  "name": "patos",
  "version": "1.0.0",
  "description": "PatOS \u2014 a macOS-style desktop that runs in the browser (works on Chromebooks).",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.js\" \"test/browser/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.test.js\"",
    "test:ci": "node --test --test-concurrency=1 \"test/unit/*.test.js\" \"test/browser/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": ">=1.50.0 <2"
  }
}
