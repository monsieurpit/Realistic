rules_version = '2';

// PatOS accounts, saved data and messages. Paste this whole file into the Firebase console:
// Firestore Database > Rules > replace everything > Publish. (docs/FIREBASE.md explains each part.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    // A username is tied to the sign-in it belongs to (name@patos.invalid), so nobody can claim someone else's name.
    function myName() { return request.auth.token.email.split('@')[0]; }
    function goodName(n) { return n is string && n.matches('^[a-z0-9_]{3,20}$'); }

    // The system account (PatOS): its uid is written ONLY in the Firebase console, in config/system { uid }. No app or
    // person can write it (see config below), so nobody can make themselves the system account, even with the name "patos".
    function cfg() { return /databases/$(database)/documents/config/system; }
    // config/system holds the uid as the field "uid" (uid: <id>), or as the name of its only field (<id>: anything)
    function sysOf(d) { return 'uid' in d ? d.uid : (d.keys().size() == 1 ? d.keys()[0] : '-none-'); }
    function sysUid() { return exists(cfg()) ? sysOf(get(cfg()).data) : '-none-'; }
    function isSys() { return signedIn() && request.auth.uid == sysUid(); }
    // a banned account (bans/{uid}, written only by the system account) can't write anything anymore
    function banned() { return signedIn() && exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }

    // config/system: who the system account is. Everyone signed in can read it (to show its badge); nobody can write it.
    match /config/{id} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // bans/{uid}: { reason, username, at, by }. Only the system account bans and unbans, and never itself.
    // The banned person can read their own ban (that is how PatOS tells them why).
    match /bans/{uid} {
      allow get: if mine(uid) || isSys();
      allow list: if isSys();
      allow create, update: if isSys() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['reason', 'username', 'at', 'by'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
        && request.resource.data.username is string && request.resource.data.username.size() <= 40
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isSys();
    }

    // usernames/{name}: who is who. Signed-in people can look names up (that is how search works).
    match /usernames/{name} {
      allow get, list: if signedIn();
      allow create: if signedIn() && !banned() && goodName(name) && name == myName()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // accounts/{uid}: the account and the saved items (files, notes, settings...), private to that person.
    // The items are encrypted on the device with a key made from the password, so even this database only holds scrambled bytes.
    match /accounts/{uid} {
      allow read: if mine(uid);
      allow create: if mine(uid) && goodName(request.resource.data.username) && request.resource.data.username == myName()
        && request.resource.data.keys().hasOnly(['username', 'epoch', 'createdAt'])
        && request.resource.data.epoch is string && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if mine(uid);

      match /records/{rid} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid) && !banned()
          && request.resource.data.keys().hasOnly(['t', 'del', 'n', 'iv', 'at'])
          && request.resource.data.t is number && request.resource.data.del is bool
          && request.resource.data.n is number && request.resource.data.n >= 0 && request.resource.data.n <= 40
          && request.resource.data.iv is string && request.resource.data.iv.size() <= 32
          && request.resource.data.at == request.time;
      }
      match /chunks/{cid} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid) && !banned()
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 800000;
      }
    }

    // conversations/{uid1_uid2}: one conversation per pair of people (the two ids, smaller first). Only the two can see it.
    function convPath(cid) { return /databases/$(database)/documents/conversations/$(cid); }
    function otherOf(d) { return d.members[0] == request.auth.uid ? d.members[1] : d.members[0]; }

    match /conversations/{cid} {
      allow get: if signedIn() && cid.matches('.*' + request.auth.uid + '.*') && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      // A first message makes a request: the other person has to accept it. The system account's first message is
      // accepted at once (status 'accepted').
      allow create: if signedIn() && !banned()
        && request.resource.data.keys().hasOnly(['members', 'usernames', 'status', 'requester', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastFrom'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requester == request.auth.uid
        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'accepted' && isSys()))
        && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.usernames[request.auth.uid] == myName()
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernames[otherOf(request.resource.data)])).data.uid == otherOf(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 140;

      allow update: if signedIn() && !banned() && request.auth.uid in resource.data.members && (
        // answering a request: only the person who was asked, and only the status. Nobody can decline the system account.
        (request.auth.uid != resource.data.requester
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.status in ['accepted', 'declined']
          && !(request.resource.data.status == 'declined' && otherOf(resource.data) == sysUid()))
        ||
        // the system account can always open a conversation it is in (a request it sent, or one it had declined)
        (isSys()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.status == 'accepted')
        ||
        // "seen" and "typing…": each person only sets their own time, in an accepted conversation
        (resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'typing'])
          && request.resource.data.get('seen', {}).diff(resource.data.get('seen', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('typing', {}).diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('seen', {})) || request.resource.data.seen[request.auth.uid] == request.time || request.resource.data.seen[request.auth.uid] == resource.data.get('seen', {})[request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('typing', {})) || request.resource.data.typing[request.auth.uid] == request.time || request.resource.data.typing[request.auth.uid] == resource.data.get('typing', {})[request.auth.uid]))
        ||
        // a new message updates the preview, but only once the request is accepted
        (resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastFrom'])
          && request.resource.data.lastFrom == request.auth.uid && request.resource.data.lastMessageAt == request.time
          && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 140)
      );
      allow delete: if false;

      // The history: messages are added, never changed or removed.
      match /messages/{mid} {
        function conv() { return getAfter(convPath(cid)).data; }
        allow read: if signedIn() && request.auth.uid in get(convPath(cid)).data.members;
        allow create: if signedIn() && !banned() && request.auth.uid in conv().members
          && request.resource.data.keys().hasOnly(['from', 'text', 't', 'at', 'img'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          // a photo: a small picture saved in the message (under 400 KB); a message has words, a photo, or both
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() > 30 && request.resource.data.img.size() <= 400000))
          && (request.resource.data.text.size() > 0 || 'img' in request.resource.data)
          && request.resource.data.t is number && request.resource.data.at == request.time
          && (conv().status == 'accepted' || (conv().status == 'pending' && conv().requester == request.auth.uid && mid == 'request'));
        // reactions: each person sets or removes only their own, once the chat is accepted; nothing else changes
        allow update: if signedIn() && !banned() && request.auth.uid in get(convPath(cid)).data.members && get(convPath(cid)).data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions) || (request.resource.data.reactions[request.auth.uid] is string && request.resource.data.reactions[request.auth.uid].size() <= 16));
        allow delete: if false;
      }
    }

    // announcements/current: a message from PatOS that everyone signed in sees. Only the system account writes it.
    match /announcements/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSys() && request.resource.data.keys().hasOnly(['text', 'at', 'by'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isSys();
    }
    // verified/{uid}: accounts PatOS gave a verified badge. Everyone signed in can see them; only the system account gives or removes one.
    match /verified/{uid} {
      allow get, list: if signedIn();
      allow create, update: if isSys() && request.resource.data.keys().hasOnly(['at', 'by'])
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isSys();
    }

    // ================= Shared Spaces =================
    // spaces/{sid}: { name, owner, members: { uid: role }, memberIds, names, created, updated }
    // Roles: owner > admin > editor > commenter > viewer. Every rule below checks the role stored in the space itself, so
    // nothing the app sends (an id, a role, a name) can give more than the space allows.
    function spacePath(sid) { return /databases/$(database)/documents/spaces/$(sid); }
    function roleIn(sid) { return signedIn() && exists(spacePath(sid)) ? get(spacePath(sid)).data.members.get(request.auth.uid, '') : ''; }
    function isMember(sid) { return roleIn(sid) != ''; }
    function canEdit(sid) { return roleIn(sid) in ['owner', 'admin', 'editor']; }
    function canComment(sid) { return roleIn(sid) in ['owner', 'admin', 'editor', 'commenter']; }
    function isSpaceAdmin(sid) { return roleIn(sid) in ['owner', 'admin']; }
    function ROLES() { return ['owner', 'admin', 'editor', 'commenter', 'viewer']; }
    // members and memberIds always say the same thing
    function consistent(d) { return d.memberIds.toSet() == d.members.keys().toSet(); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function memberDiff() { return request.resource.data.members.diff(resource.data.members).affectedKeys(); }
    function tops(m) { return m.values().size() - m.values().removeAll(['editor', 'commenter', 'viewer']).size(); }
    function owners(m) { return m.values().size() - m.values().removeAll(['owner']).size(); }

    match /spaces/{sid} {
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      // (someone with an invitation may read the space itself, its name and members, to join it; not its files)
      allow get: if signedIn() && (request.auth.uid in resource.data.memberIds || exists(/databases/$(database)/documents/spaceInvites/$(sid + '_' + request.auth.uid)));
      allow create: if signedIn() && !banned()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'memberIds', 'names', 'created', 'updated'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid]) && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid]) && request.resource.data.names[request.auth.uid] == myName()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.created == request.time && request.resource.data.updated == request.time;
      allow update: if signedIn() && !banned() && consistent(request.resource.data) && request.resource.data.updated == request.time && (
        // 1. the owner or an admin: renames, or changes one member at a time; the owner stays the only owner; an admin can't
        //    make or change admins (nor the owner)
        (isSpaceAdmin(sid) && onlyChanges(['name', 'members', 'memberIds', 'names', 'updated'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && memberDiff().size() <= 1
          && request.resource.data.members.values().hasOnly(ROLES())
          && request.resource.data.members.get(resource.data.owner, '') == 'owner' && owners(request.resource.data.members) == 1
          && (roleIn(sid) == 'owner' || tops(request.resource.data.members) == tops(resource.data.members)))
        // 2. a member (not the owner) leaves: only they disappear
        || (isMember(sid) && request.auth.uid != resource.data.owner && onlyChanges(['members', 'memberIds', 'names', 'updated'])
          && memberDiff().hasOnly([request.auth.uid]) && !(request.auth.uid in request.resource.data.members))
        // 3. someone joins with an invitation made for them: only they appear, with exactly the role it gives
        || (!isMember(sid) && exists(/databases/$(database)/documents/spaceInvites/$(sid + '_' + request.auth.uid))
          && onlyChanges(['members', 'memberIds', 'names', 'updated']) && memberDiff().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == get(/databases/$(database)/documents/spaceInvites/$(sid + '_' + request.auth.uid)).data.role
          && request.resource.data.names[request.auth.uid] == myName())
      );
      allow delete: if roleIn(sid) == 'owner';

      // files: { name, kind, content, rev, updatedBy, updatedName, updatedAt, lockedBy, lockedName, lockUntil }
      match /files/{fid} {
        allow read: if isMember(sid);
        allow create: if canEdit(sid) && !banned()
          && request.resource.data.keys().hasOnly(['name', 'kind', 'content', 'rev', 'updatedBy', 'updatedName', 'updatedAt', 'lockedBy', 'lockUntil'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.kind in ['text', 'note', 'doc', 'sheet', 'slides']
          && request.resource.data.content is string && request.resource.data.content.size() <= 200000
          && request.resource.data.rev == 1 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
        allow update: if canEdit(sid) && !banned() && (
          // a save: exactly the next revision, by you, and not while someone else holds the lock
          (onlyChanges(['content', 'rev', 'updatedBy', 'updatedName', 'updatedAt'])
            && request.resource.data.rev == resource.data.rev + 1 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
            && request.resource.data.content is string && request.resource.data.content.size() <= 200000
            && (resource.data.get('lockedBy', '') in ['', request.auth.uid] || resource.data.get('lockUntil', 0) < request.time.toMillis()))
          // taking or giving back the lock (only when it is free, yours, or ran out)
          || (onlyChanges(['lockedBy', 'lockedName', 'lockUntil'])
            && request.resource.data.lockedBy in ['', request.auth.uid]
            && (resource.data.get('lockedBy', '') in ['', request.auth.uid] || resource.data.get('lockUntil', 0) < request.time.toMillis()))
        );
        allow delete: if canEdit(sid);
        // each saved revision, written together with the save that made it, never changed afterwards
        match /revs/{rev} {
          allow read: if isMember(sid);
          allow create: if canEdit(sid) && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
            && request.resource.data.keys().hasOnly(['content', 'by', 'byName', 'at'])
            && getAfter(/databases/$(database)/documents/spaces/$(sid)/files/$(fid)).data.rev == int(rev);
          allow update: if false;
          allow delete: if canEdit(sid);
        }
      }
      // comments: written as yourself; removed by their author, or by the owner or an admin
      match /comments/{cid} {
        allow read: if isMember(sid);
        allow create: if canComment(sid) && !banned() && request.resource.data.keys().hasOnly(['fid', 'text', 'by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid && request.resource.data.byName == myName() && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isMember(sid) && (resource.data.by == request.auth.uid || isSpaceAdmin(sid));
      }
      // activity: what happened, written as yourself, never changed
      match /activity/{aid} {
        allow read: if isMember(sid);
        // (a member, or someone who becomes one in the same write: creating the space, joining it)
        allow create: if (isMember(sid) || getAfter(spacePath(sid)).data.members.get(request.auth.uid, '') != '')
          && request.resource.data.keys().hasOnly(['what', 'name', 'by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid && request.resource.data.byName == myName() && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if roleIn(sid) == 'owner';
      }

      // ================= Live (4.0): working together, in real time, inside a space =================
      // Same roles as the rest of the space. Things that several people edit (board items, note blocks, tasks) carry a
      // revision: a write must be exactly the next one, so two people can never overwrite each other without knowing.
      // presence/{uid}: { name, app, state, at }: only your own, seen by the members
      match /presence/{uid} {
        allow read: if isMember(sid);
        allow create, update: if isMember(sid) && !banned() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'app', 'state', 'at'])
          && request.resource.data.name == myName()
          && request.resource.data.app is string && request.resource.data.app.size() <= 40
          && request.resource.data.state in ['active', 'away']
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (uid == request.auth.uid || isSpaceAdmin(sid));
      }
      // boards/{bid}: { name, by, byName, at }   and   notes/{nid}: { title, by, byName, at }
      match /boards/{bid} {
        allow read: if isMember(sid);
        allow create: if canEdit(sid) && !banned() && liveHead(request.resource.data, 'name');
        allow update: if canEdit(sid) && !banned() && onlyChanges(['name']) && goodTitle(request.resource.data.name);
        allow delete: if canEdit(sid);
        // items/{iid}: { kind, x, y, w, h, text, color, rev, by, byName, at }
        match /items/{iid} {
          allow read: if isMember(sid);
          allow create: if canEdit(sid) && !banned() && boardItem(request.resource.data) && request.resource.data.rev == 1;
          allow update: if canEdit(sid) && !banned() && boardItem(request.resource.data) && nextRev() && request.resource.data.kind == resource.data.kind;
          allow delete: if canEdit(sid);
        }
      }
      match /notes/{nid} {
        allow read: if isMember(sid);
        allow create: if canEdit(sid) && !banned() && liveHead(request.resource.data, 'title');
        allow update: if canEdit(sid) && !banned() && onlyChanges(['title']) && goodTitle(request.resource.data.title);
        allow delete: if canEdit(sid);
        // blocks/{blk}: one paragraph each { order, text, rev, by, byName, at }: two people can write different paragraphs
        // at the same time; the same paragraph needs the next revision
        match /blocks/{blk} {
          allow read: if isMember(sid);
          allow create: if canEdit(sid) && !banned() && noteBlock(request.resource.data) && request.resource.data.rev == 1;
          allow update: if canEdit(sid) && !banned() && noteBlock(request.resource.data) && nextRev();
          allow delete: if canEdit(sid);
        }
      }
      // tasks/{tid}: { text, done, assignee, rev, by, byName, at }: the assignee is nobody ('') or a member
      match /tasks/{tid} {
        allow read: if isMember(sid);
        allow create: if canEdit(sid) && !banned() && liveTask(sid, request.resource.data) && request.resource.data.rev == 1;
        allow update: if canEdit(sid) && !banned() && liveTask(sid, request.resource.data) && nextRev();
        allow delete: if canEdit(sid);
      }
      // calls/{cid}: { by, byName, at }   voice: members who can comment can talk
      match /calls/{cid} {
        allow read: if isMember(sid);
        allow create: if canComment(sid) && !banned() && request.resource.data.keys().hasOnly(['by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid && request.resource.data.byName == myName() && request.resource.data.at == request.time;
        allow update: if false;
        // (the last one out ends it, whoever started it; the sound itself is browser to browser and isn't cut by this)
        allow delete: if canComment(sid);
        // peers/{uid}: who is in the call, only yourself
        match /peers/{uid} {
          allow read: if isMember(sid);
          allow create, update: if canComment(sid) && !banned() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['name', 'at'])
            && request.resource.data.name == myName() && request.resource.data.at == request.time;
          allow delete: if signedIn() && (uid == request.auth.uid || isSpaceAdmin(sid));
        }
        // signals/{id}: { from, to, type, data, at }: how two browsers find each other (WebRTC). Only the two people it
        // is between can read it; the sound itself goes browser to browser and never through the database.
        match /signals/{id} {
          allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
          allow create: if canComment(sid) && !banned() && request.resource.data.keys().hasOnly(['from', 'to', 'type', 'data', 'at'])
            && request.resource.data.from == request.auth.uid && request.resource.data.to is string && request.resource.data.to != request.auth.uid
            && get(spacePath(sid)).data.members.get(request.resource.data.to, '') != ''
            && request.resource.data.type in ['offer', 'answer', 'ice', 'bye']
            && request.resource.data.data is string && request.resource.data.data.size() <= 20000
            && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        }
      }
    }

    // ================= Commons (4.0): communities, profiles, follows =================
    // communities/{cid}: { name, about, visibility, owner, tags, by, byName, at }
    //   public: anyone signed in reads it and its posts and may join; private: only its members (joining needs a moderator's yes)
    // communities/{cid}/members/{uid}: { name, role, at, lastPost }  role: owner > mod > member; 'pending' = asked to join
    // communities/{cid}/bans/{uid}: written by moderators; a banned person can't join, post, like or report there
    // communities/{cid}/posts/{pid}: { kind, title, text, by, byName, at, eventAt, place, endsAt, challenge, attach, attachKind }
    // communities/{cid}/posts/{pid}/likes/{uid}, communities/{cid}/reports/{pid_uid}
    // Rate limit: a post must also move your lastPost to now, and the one before must be at least 20 s old.
    function comPath(cid) { return /databases/$(database)/documents/communities/$(cid); }
    function memPath(cid, uid) { return /databases/$(database)/documents/communities/$(cid)/members/$(uid); }
    function comRole(cid) { return signedIn() && exists(memPath(cid, request.auth.uid)) ? get(memPath(cid, request.auth.uid)).data.role : ''; }
    function comMember(cid) { return comRole(cid) in ['owner', 'mod', 'member']; }
    function comMod(cid) { return comRole(cid) in ['owner', 'mod'] || isSys(); }
    function comBanned(cid) { return signedIn() && exists(/databases/$(database)/documents/communities/$(cid)/bans/$(request.auth.uid)); }
    function comPublic(cid) { return exists(comPath(cid)) && get(comPath(cid)).data.visibility == 'public'; }
    function comCanRead(cid) { return signedIn() && (comPublic(cid) || comMember(cid) || isSys()); }
    function goodText(t, max) { return t is string && t.size() <= max; }

    match /communities/{cid} {
      allow get: if signedIn() && (resource.data.visibility == 'public' || comMember(cid) || comRole(cid) == 'pending' || isSys());
      allow list: if signedIn() && resource.data.visibility == 'public';
      // made by you, and you are its owner in the same write
      allow create: if signedIn() && !banned() && request.resource.data.keys().hasOnly(['name', 'about', 'visibility', 'owner', 'tags', 'by', 'byName', 'at'])
        && request.resource.data.owner == request.auth.uid && stamped(request.resource.data) && goodTitle(request.resource.data.name)
        && goodText(request.resource.data.about, 500) && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 5
        && getAfter(memPath(cid, request.auth.uid)).data.role == 'owner';
      allow update: if comMod(cid) && !banned() && onlyChanges(['name', 'about', 'visibility', 'tags'])
        && goodTitle(request.resource.data.name) && goodText(request.resource.data.about, 500) && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 5;
      allow delete: if (signedIn() && resource.data.owner == request.auth.uid) || isSys();

      match /members/{uid} {
        allow read: if comCanRead(cid) || (signedIn() && uid == request.auth.uid);
        allow create: if signedIn() && !banned() && !comBanned(cid) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'at', 'lastPost']) && request.resource.data.name == myName()
          && request.resource.data.at == request.time && request.resource.data.lastPost == timestamp.value(0)
          && (
            // the owner, while making the community
            (request.resource.data.role == 'owner' && !exists(comPath(cid)) && getAfter(comPath(cid)).data.owner == request.auth.uid)
            // anyone joins a public one; a private one is asked for
            || (request.resource.data.role == 'member' && comPublic(cid))
            || (request.resource.data.role == 'pending' && exists(comPath(cid)) && !comPublic(cid))
          );
        allow update: if signedIn() && !banned() && (
          // your own last post time (the rate limit), nothing else
          (uid == request.auth.uid && onlyChanges(['lastPost']) && request.resource.data.lastPost == request.time)
          // a moderator lets someone in, or makes / unmakes a moderator (only the owner does that); nobody becomes owner
          || (comMod(cid) && onlyChanges(['role']) && resource.data.role != 'owner' && request.resource.data.role in ['member', 'mod']
              && (request.resource.data.role != 'mod' && resource.data.role != 'mod' || comRole(cid) == 'owner'))
        );
        // leave (not the owner), or a moderator removes someone (not the owner, and only the owner removes moderators)
        allow delete: if signedIn() && resource.data.role != 'owner' && (uid == request.auth.uid || (comMod(cid) && (resource.data.role != 'mod' || comRole(cid) == 'owner')));
      }
      match /bans/{uid} {
        allow read: if comMod(cid) || (signedIn() && uid == request.auth.uid);
        allow create: if comMod(cid) && !banned() && uid != get(comPath(cid)).data.owner && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
          && goodText(request.resource.data.reason, 300) && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if comMod(cid);
      }
      match /posts/{pid} {
        allow read: if comCanRead(cid);
        allow create: if comMember(cid) && !banned() && !comBanned(cid)
          && request.resource.data.keys().hasOnly(['kind', 'title', 'text', 'by', 'byName', 'at', 'eventAt', 'place', 'endsAt', 'challenge', 'attach', 'attachKind'])
          && stamped(request.resource.data) && goodText(request.resource.data.title, 120) && goodText(request.resource.data.text, 4000)
          && request.resource.data.kind in ['post', 'announcement', 'event', 'showcase', 'challenge', 'entry']
          // announcements and challenges come from moderators
          && (!(request.resource.data.kind in ['announcement', 'challenge']) || comMod(cid))
          && (request.resource.data.kind != 'event' || request.resource.data.eventAt is timestamp)
          && (request.resource.data.kind != 'challenge' || request.resource.data.endsAt is timestamp)
          // an entry answers a challenge of this community that is still open
          && (request.resource.data.kind != 'entry' || (request.resource.data.challenge is string
              && get(/databases/$(database)/documents/communities/$(cid)/posts/$(request.resource.data.challenge)).data.kind == 'challenge'
              && get(/databases/$(database)/documents/communities/$(cid)/posts/$(request.resource.data.challenge)).data.endsAt > request.time))
          // something shared: a desktop, a gallery or a widget made in Studio (data only, never code), 150 KB at most
          && (!('attach' in request.resource.data) || (request.resource.data.attachKind in ['desk', 'gallery', 'widget'] && goodText(request.resource.data.attach, 150000)))
          && goodText(request.resource.data.get('place', ''), 120)
          // the rate limit
          && get(memPath(cid, request.auth.uid)).data.lastPost < request.time - duration.value(20, 's')
          && getAfter(memPath(cid, request.auth.uid)).data.lastPost == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.by == request.auth.uid || comMod(cid));
        match /likes/{uid} {
          allow read: if comCanRead(cid);
          allow create: if comMember(cid) && !banned() && !comBanned(cid) && uid == request.auth.uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if signedIn() && uid == request.auth.uid;
        }
      }
      // one report per person per post; only moderators read them
      match /reports/{rid} {
        allow read: if comMod(cid);
        allow create: if comCanRead(cid) && !banned() && !comBanned(cid) && request.resource.data.keys().hasOnly(['pid', 'reason', 'by', 'at'])
          && rid == request.resource.data.pid + '_' + request.auth.uid && goodText(request.resource.data.reason, 300)
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if comMod(cid);
      }
    }
    // profiles/{uid}: { name, bio, updated }: anyone signed in reads; only you write yours
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && !banned() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['name', 'bio', 'updated'])
        && request.resource.data.name == myName() && goodText(request.resource.data.bio, 300) && request.resource.data.updated == request.time;
      allow delete: if signedIn() && uid == request.auth.uid;
    }
    // follows/{from_to} and blocks/{from_to}: { from, to, at }, made by "from". You can't follow someone who blocked you.
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && !banned() && request.resource.data.keys().hasOnly(['from', 'to', 'at']) && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid && id == request.auth.uid + '_' + request.resource.data.to
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.auth.uid)) && request.resource.data.at == request.time;
      allow update: if false;
      // (you stop following; or the person followed removes you, which is what blocking does)
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /blocks/{id} {
      allow read: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['from', 'to', 'at']) && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid && id == request.auth.uid + '_' + request.resource.data.to && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // ---- Live helpers ----
    function goodTitle(t) { return t is string && t.size() > 0 && t.size() <= 60; }
    function stamped(d) { return d.by == request.auth.uid && d.byName == myName() && d.at == request.time; }
    function liveHead(d, field) { return d.keys().hasOnly([field, 'by', 'byName', 'at']) && goodTitle(d[field]) && stamped(d); }
    function nextRev() { return request.resource.data.rev == resource.data.rev + 1; }
    function inRange(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }
    function boardItem(d) {
      return d.keys().hasOnly(['kind', 'x', 'y', 'w', 'h', 'text', 'color', 'rev', 'by', 'byName', 'at'])
        && d.kind in ['sticky', 'text', 'box'] && inRange(d.x, -100000, 100000) && inRange(d.y, -100000, 100000)
        && inRange(d.w, 20, 2000) && inRange(d.h, 20, 2000) && d.text is string && d.text.size() <= 2000
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$') && d.rev is int && stamped(d);
    }
    function noteBlock(d) {
      return d.keys().hasOnly(['order', 'text', 'rev', 'by', 'byName', 'at']) && inRange(d.order, -1000000000, 1000000000)
        && d.text is string && d.text.size() <= 5000 && d.rev is int && stamped(d);
    }
    function liveTask(sid, d) {
      return d.keys().hasOnly(['text', 'done', 'assignee', 'rev', 'by', 'byName', 'at']) && d.text is string && d.text.size() > 0 && d.text.size() <= 300
        && d.done is bool && d.assignee is string && (d.assignee == '' || get(spacePath(sid)).data.members.get(d.assignee, '') != '')
        && d.rev is int && stamped(d);
    }

    // spaceInvites/{sid_uid}: { sid, uid, username, role, spaceName, by, byName, at }. Made by the space's owner or an admin
    // (an admin can't invite admins), for someone not already in it; seen by the person invited and by who invited them.
    match /spaceInvites/{iid} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.by == request.auth.uid);
      allow create: if signedIn() && !banned()
        && request.resource.data.keys().hasOnly(['sid', 'uid', 'username', 'role', 'spaceName', 'by', 'byName', 'at'])
        && iid == request.resource.data.sid + '_' + request.resource.data.uid
        && isSpaceAdmin(request.resource.data.sid)
        && request.resource.data.role in ['admin', 'editor', 'commenter', 'viewer']
        && (request.resource.data.role != 'admin' || roleIn(request.resource.data.sid) == 'owner')
        && !(request.resource.data.uid in get(spacePath(request.resource.data.sid)).data.members)
        && request.resource.data.by == request.auth.uid && request.resource.data.byName == myName() && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.by == request.auth.uid || isSpaceAdmin(resource.data.sid));
    }

    // (4.1) game leaderboards: scores/{board}/players/{uid}, one best score per person and board ("2048", "orbrunner",
    // "2048-d20261114" for a daily challenge). Anyone signed in reads them; you only write your own, under your own
    // username, and a score can only go up.
    function goodScore() {
      return request.resource.data.keys().hasOnly(['username', 'score', 'at'])
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000000
        && request.resource.data.username == myName() && request.resource.data.at == request.time;
    }
    match /scores/{board}/players/{uid} {
      allow read: if signedIn();
      allow create: if mine(uid) && !banned() && board.matches('^[a-z0-9-]{1,40}$') && goodScore();
      allow update: if mine(uid) && !banned() && goodScore() && request.resource.data.score > resource.data.score;
      allow delete: if mine(uid);
    }

    // everything else stays closed
    match /{document=**} { allow read, write: if false; }
  }
}
