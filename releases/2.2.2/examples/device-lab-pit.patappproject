{
  "format": "patappproject",
  "formatVersion": 1,
  "exported": "2026-11-05",
  "meta": {
    "name": "Device Lab PitCode",
    "id": "com.patos.devicelab.pit",
    "version": "1.0.0",
    "author": "PatOS",
    "description": "The Device Lab test app, written in PitCode: files, notifications, clipboard, camera, microphone, location and internet.",
    "icon": "DL",
    "color": "#0e7490",
    "permissions": [
      "files",
      "notifications",
      "clipboard",
      "camera",
      "microphone",
      "location",
      "network"
    ],
    "language": "pitcode",
    "entry": "main.pitx",
    "width": 980,
    "height": 720
  },
  "files": {
    "lab.pit": "// Device Lab (PitCode): what every button does. Each one calls the PatOS SDK through js.patos.\n// Storage, window and theme need no permission. The others ask the first time.\n\nuse { state, put, track, kb, stamp, reportText } from \"./tools\"\n\n// ----- storage -----\nshare storageSet() => {\n  attempt {\n    when state.sKey.trim() == \"\" { raise \"Type a key first.\" }\n    wait track(nil, \"storage.set\", () => js.patos.storage.set(state.sKey.trim(), state.sVal))\n    put(\"storage\", \"Saved \\\"{state.sKey.trim()}\\\".\", \"ok\")\n  } rescue e {\n    put(\"storage\", e.message, \"err\")\n  }\n}\n\nshare storageGet() => {\n  attempt {\n    pit value = wait track(nil, \"storage.get\", () => js.patos.storage.get(state.sKey.trim()))\n    put(\"storage\", value == nil ? \"Nothing is saved under \\\"{state.sKey.trim()}\\\".\" : \"\\\"{state.sKey.trim()}\\\" = {json.text(value)}\", \"ok\")\n  } rescue e {\n    put(\"storage\", e.message, \"err\")\n  }\n}\n\nshare storageRemove() => {\n  attempt {\n    wait track(nil, \"storage.remove\", () => js.patos.storage.remove(state.sKey.trim()))\n    put(\"storage\", \"Removed \\\"{state.sKey.trim()}\\\".\", \"ok\")\n  } rescue e {\n    put(\"storage\", e.message, \"err\")\n  }\n}\n\nshare storageKeys() => {\n  attempt {\n    pit keys = wait track(nil, \"storage.keys\", () => js.patos.storage.keys())\n    put(\"storage\", keys.size == 0 ? \"No keys yet.\" : \"Keys: \" + [...keys].join(\", \"), \"ok\")\n  } rescue e {\n    put(\"storage\", e.message, \"err\")\n  }\n}\n\nshare storageClear() => {\n  attempt {\n    wait track(nil, \"storage.clear\", () => js.patos.storage.clear())\n    put(\"storage\", \"Everything was cleared.\", \"ok\")\n  } rescue e {\n    put(\"storage\", e.message, \"err\")\n  }\n}\n\n// ----- files -----\nfileName() => {\n  pit name = state.fName.trim()\n  when name == \"\" { raise \"Type a file name first.\" }\n  back name\n}\n\nshare filesList() => {\n  attempt {\n    pit dir = state.fDir.trim()\n    pit found = wait track(\"files\", \"files.list\", () => js.patos.files.list(dir))\n    state.files = [...found].map(f => ({name: f.name, folder: f.folder, size: f.size}))\n    pit where = dir == \"\" ? \"the app folder\" : dir\n    put(\"files\", state.files.size == 0 ? \"Nothing in {where} yet.\" : \"{state.files.size} item(s) in {where}.\", \"ok\")\n  } rescue e {\n    put(\"files\", e.message, \"err\")\n  }\n}\n\nshare filesSave() => {\n  attempt {\n    pit name = fileName()\n    wait track(\"files\", \"files.write\", () => js.patos.files.write(name, state.fText))\n    put(\"files\", \"Saved {name} ({kb(state.fText.size)}).\", \"ok\")\n    wait filesList()\n  } rescue e {\n    put(\"files\", e.message, \"err\")\n  }\n}\n\nshare filesOpen() => {\n  attempt {\n    pit name = fileName()\n    pit content = wait track(\"files\", \"files.read\", () => js.patos.files.read(name))\n    when content == nil {\n      put(\"files\", \"There is no file called {name}.\", \"ok\")\n      back\n    }\n    state.fText = content\n    put(\"files\", \"Opened {name} ({kb(content.size)}).\", \"ok\")\n  } rescue e {\n    put(\"files\", e.message, \"err\")\n  }\n}\n\nshare filesDelete() => {\n  attempt {\n    pit name = fileName()\n    wait track(\"files\", \"files.remove\", () => js.patos.files.remove(name))\n    put(\"files\", \"Deleted {name}.\", \"ok\")\n    wait filesList()\n  } rescue e {\n    put(\"files\", e.message, \"err\")\n  }\n}\n\n// Click on a name in the list: a folder opens, a file loads.\nshare filesPick(item) => {\n  pit prefix = state.fDir.trim() == \"\" ? \"\" : state.fDir.trim() + \"/\"\n  state.fName = prefix + item.name\n  when item.folder {\n    state.fDir = prefix + item.name\n    filesList()\n  } other {\n    filesOpen()\n  }\n}\n\n// ----- notifications -----\nsendNote(extra) => js.patos.notify({title: state.nTitle, body: state.nBody + extra})\n\nshare notifyNow() => {\n  attempt {\n    wait track(\"notifications\", \"notify (now)\", () => sendNote(\"\"))\n    put(\"notify\", \"Sent. Look at the top right of PatOS.\", \"ok\")\n  } rescue e {\n    put(\"notify\", e.message, \"err\")\n  }\n}\n\nshare notifyLater() => {\n  attempt {\n    loop left in 5..0 {\n      put(\"notify\", \"Sending in {left}...\")\n      wait sleep(1000)\n    }\n    wait track(\"notifications\", \"notify (after 5 seconds)\", () => sendNote(\"\"))\n    put(\"notify\", \"Sent after 5 seconds.\", \"ok\")\n  } rescue e {\n    put(\"notify\", e.message, \"err\")\n  }\n}\n\nshare notifyThree() => {\n  attempt {\n    wait track(\"notifications\", \"notify (3 in a row)\", () => {\n      loop n in 1..=3 {\n        wait sendNote(\" ({n})\")\n        wait sleep(600)\n      }\n    })\n    put(\"notify\", \"Sent 3 notifications.\", \"ok\")\n  } rescue e {\n    put(\"notify\", e.message, \"err\")\n  }\n}\n\n// ----- clipboard -----\nshare clipCopy() => {\n  attempt {\n    wait track(\"clipboard\", \"clipboard.write\", () => js.patos.clipboard.write(state.cText))\n    put(\"clip\", \"Copied. Paste it anywhere to check.\", \"ok\")\n  } rescue e {\n    put(\"clip\", e.message, \"err\")\n  }\n}\n\nshare clipPaste() => {\n  attempt {\n    pit pasted = wait track(\"clipboard\", \"clipboard.read\", () => js.patos.clipboard.read())\n    state.cText = pasted\n    put(\"clip\", \"Pasted {pasted.size} character(s) into the box above.\", \"ok\")\n  } rescue e {\n    put(\"clip\", e.message, \"err\")\n  }\n}\n\n// ----- camera -----\nshare galleryLoad() => {\n  attempt {\n    pit found = [...(wait js.patos.files.list(\"photos\"))].keep(f => not f.folder).takeLast(6)\n    pit shots = []\n    loop f in found {\n      pit data = wait js.patos.files.read(\"photos/{f.name}\")\n      when data != nil { shots = [...shots, {name: f.name, data: data}] }\n    }\n    state.gallery = shots\n  } rescue e {\n    state.gallery = []\n  }\n}\n\nshare cameraSnap() => {\n  attempt {\n    put(\"camera\", \"Asking the camera...\")\n    pit picture = wait track(\"camera\", \"camera.snapshot\", () => js.patos.camera.snapshot())\n    state.photo = picture\n    put(\"camera\", \"Got a picture ({kb(picture.size * 0.75)}).\", \"ok\")\n  } rescue e {\n    put(\"camera\", e.message, \"err\")\n  }\n}\n\nshare cameraSave() => {\n  attempt {\n    when state.photo == nil { back }\n    pit name = \"photos/photo-{time.now()}.jpg\"\n    wait track(\"files\", \"files.write (photo)\", () => js.patos.files.write(name, state.photo))\n    put(\"camera\", \"Saved {name}\", \"ok\")\n    wait galleryLoad()\n  } rescue e {\n    put(\"camera\", e.message, \"err\")\n  }\n}\n\n// ----- microphone -----\nshare micRecord(ms = nil) => {\n  pit length = ms ?? int(state.micSecs)\n  pit started = time.now()\n  pit timer = every(200, () => { state.micPct = math.min(100, (time.now() - started) / length * 100) })\n  attempt {\n    put(\"mic\", \"Recording... speak now.\")\n    pit sound = wait track(\"microphone\", \"microphone.record ({length / 1000} s)\", () => js.patos.microphone.record(length))\n    state.audio = sound\n    state.micPct = 100\n    put(\"mic\", \"Recorded {kb(sound.size * 0.75)}. Press play to hear it.\", \"ok\")\n  } rescue e {\n    state.micPct = 0\n    put(\"mic\", e.message, \"err\")\n  } always {\n    cancel(timer)\n  }\n}\n\nshare micSave() => {\n  attempt {\n    when state.audio == nil { back }\n    pit name = \"audio/recording-{time.now()}.txt\"\n    wait track(\"files\", \"files.write (recording)\", () => js.patos.files.write(name, state.audio))\n    put(\"mic\", \"Saved {name} (the sound as a data: address).\", \"ok\")\n  } rescue e {\n    put(\"mic\", e.message, \"err\")\n  }\n}\n\n// ----- location -----\nshare locationGet() => {\n  attempt {\n    put(\"loc\", \"Finding you (up to 15 seconds)...\")\n    pit p = wait track(\"location\", \"location.get\", () => js.patos.location.get())\n    state.coords = {lat: p.lat, lon: p.lon, accuracy: p.accuracy}\n    put(\"loc\", \"Found at {stamp()}.\", \"ok\")\n  } rescue e {\n    put(\"loc\", e.message, \"err\")\n  }\n}\n\nshare locationCopy() => {\n  attempt {\n    when state.coords == nil { back }\n    pit line = \"{state.coords.lat.fixed(5)}, {state.coords.lon.fixed(5)}\"\n    wait track(\"clipboard\", \"clipboard.write (coordinates)\", () => js.patos.clipboard.write(line))\n    put(\"loc\", \"Copied {line}\", \"ok\")\n  } rescue e {\n    put(\"loc\", e.message, \"err\")\n  }\n}\n\nshare locationPlace() => {\n  attempt {\n    when state.coords == nil { back }\n    pit address = \"https://nominatim.openstreetmap.org/reverse?format=json&zoom=14&lat={state.coords.lat}&lon={state.coords.lon}\"\n    pit found = wait track(\"network\", \"internet (place name)\", () => getJson(address))\n    put(\"loc\", \"Near: \" + (found.display_name ?? \"somewhere\"), \"ok\")\n  } rescue e {\n    put(\"loc\", e.message, \"err\")\n  }\n}\n\n// ----- internet -----\ngetJson(address) => {\n  pit r = wait fetch(address, {timeout: 12000})\n  when not r.ok { raise \"The server said {r.status}.\" }\n  back wait r.json()\n}\n\n// A GET that reports the status, the time it took, and the start of the answer.\nget(address) => {\n  when not address.startsWith(\"https://\") { raise \"Only https:// addresses work.\" }\n  pit began = js.performance.now()\n  pit r = wait fetch(address, {timeout: 12000})\n  pit body = wait r.text()\n  back {status: r.status, ms: math.round(js.performance.now() - began), body: body}\n}\n\nshowGet(res) => {\n  pit more = res.body.size > 700 ? \"\\n... ({res.body.size} characters)\" : \"\"\n  put(\"net\", \"{res.status} in {res.ms} ms\\n\\n{res.body.part(0, 700)}{more}\", \"ok\")\n}\n\nnetFail(e) => {\n  pit msg = text(e.message)\n  put(\"net\", \"Could not reach it. Check the address starts with https://, that you are online, and that the site allows other pages to read it. ({msg})\", \"err\")\n}\n\nshare netGet() => {\n  attempt {\n    put(\"net\", \"Asking...\")\n    showGet(wait track(\"network\", \"internet GET\", () => get(state.uUrl.trim())))\n  } rescue e {\n    netFail(e)\n  }\n}\n\nshare netZen() => {\n  attempt {\n    put(\"net\", \"Asking...\")\n    state.uUrl = \"https://api.github.com/zen\"\n    showGet(wait track(\"network\", \"internet (advice)\", () => get(state.uUrl)))\n  } rescue e {\n    netFail(e)\n  }\n}\n\nshare netIp() => {\n  attempt {\n    put(\"net\", \"Asking...\")\n    state.uUrl = \"https://api.ipify.org?format=json\"\n    showGet(wait track(\"network\", \"internet (public address)\", () => get(state.uUrl)))\n  } rescue e {\n    netFail(e)\n  }\n}\n\nshare netPicture() => {\n  attempt {\n    put(\"net\", \"Loading a picture...\")\n    state.picture = nil\n    pit address = \"https://picsum.photos/seed/patos/600/260?t={time.now()}\"\n    wait track(\"network\", \"internet (picture)\", () => js.Promise((ok, no) => {\n      pit img = js.Image()\n      img.onload = () => ok(true)\n      img.onerror = () => no(js.Error(\"The picture did not load.\"))\n      img.src = address\n    }))\n    state.picture = address\n    put(\"net\", \"The picture loaded.\", \"ok\")\n  } rescue e {\n    put(\"net\", e.message, \"err\")\n  }\n}\n\nshare netSpeed() => {\n  attempt {\n    put(\"net\", \"Testing 5 times...\")\n    pit times = wait track(\"network\", \"internet (speed test)\", () => speedRuns())\n    pit list = times.join(\", \")\n    pit average = math.round(times.average())\n    put(\"net\", \"Round trips: {list} ms\\nAverage: {average} ms\", \"ok\")\n  } rescue e {\n    netFail(e)\n  }\n}\n\nspeedRuns() => {\n  pit times = []\n  loop 5 times {\n    pit res = wait get(\"https://api.github.com/zen?t={time.now()}\")\n    times = [...times, res.ms]\n  }\n  back times\n}\n\n// ----- window and theme -----\nshare windowTitle() => {\n  attempt {\n    wait track(nil, \"window.setTitle\", () => js.patos.window.setTitle(state.wTitle))\n    put(\"win\", \"The window title changed.\", \"ok\")\n  } rescue e {\n    put(\"win\", e.message, \"err\")\n  }\n}\n\nshare windowInfo() => {\n  attempt {\n    pit info = wait track(nil, \"info\", () => js.patos.info())\n    state.theme = {bg: info.bg, text: info.text, accent: info.accent}\n    put(\"win\", json.text({dark: info.dark, bg: info.bg, text: info.text, accent: info.accent, language: info.language, mobile: info.mobile}, 2), \"ok\")\n  } rescue e {\n    put(\"win\", e.message, \"err\")\n  }\n}\n\nshare windowClose() => js.patos.window.close()\n\n// ----- the report -----\nshare reportCopy() => {\n  attempt {\n    wait track(\"clipboard\", \"clipboard.write (report)\", () => js.patos.clipboard.write(reportText()))\n  } rescue e {\n  }\n}\n\nshare reportSave() => {\n  attempt {\n    pit name = \"reports/report-{time.now()}.txt\"\n    wait track(\"files\", \"files.write (report)\", () => js.patos.files.write(name, reportText()))\n    js.patos.notify({title: \"Report saved\", body: name})\n  } rescue e {\n  }\n}\n\nshare reportClear() => {\n  state.report = []\n}\n\n// ----- the two test runs -----\n// Each step is allowed to fail: the report says which ones did.\nstep(task) => {\n  attempt {\n    wait task()\n  } rescue e {\n  }\n}\n\nquietTests() => {\n  wait step(() => track(nil, \"storage.set/get\", () => {\n    wait js.patos.storage.set(\"selftest\", stamp())\n    when (wait js.patos.storage.get(\"selftest\")) == nil { raise \"Nothing came back.\" }\n  }))\n  wait step(() => track(nil, \"info\", () => {\n    pit info = wait js.patos.info()\n    state.theme = {bg: info.bg, text: info.text, accent: info.accent}\n  }))\n  wait step(() => track(nil, \"window.setTitle\", () => js.patos.window.setTitle(\"Device Lab - self test\")))\n  wait step(() => track(\"files\", \"files write, read, list, remove\", () => {\n    pit path = \"lab/self-test.txt\"\n    pit want = \"self test {stamp()}\"\n    wait js.patos.files.write(path, want)\n    when (wait js.patos.files.read(path)) != want { raise \"The file came back different.\" }\n    pit found = [...(wait js.patos.files.list(\"lab\"))]\n    when not found.any(f => f.name == \"self-test.txt\") { raise \"The file is not in the list.\" }\n    wait js.patos.files.remove(path)\n    when (wait js.patos.files.read(path)) != nil { raise \"The file was not removed.\" }\n  }))\n}\n\nshare runQuiet() => {\n  state.busy = true\n  wait quietTests()\n  wait filesList()\n  state.busy = false\n}\n\nshare runAll() => {\n  state.busy = true\n  wait quietTests()\n  wait step(() => track(\"notifications\", \"notify (self test)\", () => js.patos.notify({title: \"Device Lab\", body: \"Self test: notifications work.\"})))\n  wait step(() => track(\"clipboard\", \"clipboard write and read\", () => {\n    pit word = \"device-lab-{time.now()}\"\n    wait js.patos.clipboard.write(word)\n    when (wait js.patos.clipboard.read()) != word { raise \"The clipboard has something else now.\" }\n  }))\n  wait step(() => track(\"location\", \"location.get (self test)\", () => {\n    pit p = wait js.patos.location.get()\n    state.coords = {lat: p.lat, lon: p.lon, accuracy: p.accuracy}\n  }))\n  wait step(() => track(\"network\", \"internet (self test)\", () => {\n    pit res = wait get(\"https://api.github.com/zen\")\n    when res.status != 200 { raise \"Got status {res.status}\" }\n  }))\n  wait step(() => track(\"camera\", \"camera.snapshot (self test)\", () => {\n    state.photo = wait js.patos.camera.snapshot()\n  }))\n  wait step(() => track(\"microphone\", \"microphone.record 1 s (self test)\", () => {\n    state.audio = wait js.patos.microphone.record(1000)\n  }))\n  pit bad = state.report.count(r => not r.ok)\n  wait step(() => js.patos.notify({title: \"Device Lab\", body: bad > 0 ? \"{bad} test(s) failed. See the report.\" : \"Everything works.\"}))\n  state.busy = false\n}\n",
    "main.pitx": "// Device Lab (PitCode): the screen. The shared state is in tools.pit, what the buttons do is in lab.pit.\n\nuse { state, PERMS, LABELS, kb, put } from \"./tools\"\nuse { storageSet, storageGet, storageRemove, storageKeys, storageClear,\n  filesSave, filesOpen, filesDelete, filesList, filesPick, galleryLoad,\n  notifyNow, notifyLater, notifyThree, clipCopy, clipPaste,\n  cameraSnap, cameraSave, micRecord, micSave, locationGet, locationCopy, locationPlace,\n  netGet, netZen, netIp, netPicture, netSpeed, windowTitle, windowInfo, windowClose,\n  reportCopy, reportSave, reportClear, runAll, runQuiet } from \"./lab\"\n\n// A button. `go` is what it does; `tone` is \"primary\" or \"danger\"; `off` greys it out.\nBtn({label, go, tone, off}) => <button class={\"btn \" + (tone ?? \"\")} disabled={off ?? false} onClick={() => go()}>{label}</button>\n\n// The text under a card (green when it worked, red when it did not).\nOut({id}) => {\n  pit o = state.outs[id]\n  back <pre class={\"out \" + (o == nil ? \"\" : o.tone)}>{o == nil ? \"\" : o.text}</pre>\n}\n\nCard({title, hint, wide, children}) => <section class={wide ? \"card wide\" : \"card\"}>\n  <h2>{title}</h2>\n  <p class=\"hint\">{hint}</p>\n  {children}\n</section>\n\nText({value, set, place}) => <input value={value} placeholder={place} onInput={e => set(e.target.value)} />\n\n// One colored chip per permission: works, refused, or not tried yet.\nPermChips() => <nav class=\"perms\">\n  {PERMS.map(p => {\n    pit status = state.perms[p]\n    pit shown = status == \"ok\" ? \"works\" : status == \"no\" ? \"refused\" : \"not tried yet\"\n    back <span key={p} class={\"chip \" + (status == \"ok\" ? \"ok\" : status == \"no\" ? \"no\" : \"warn\")}><i></i>{LABELS[p]}: {shown}</span>\n  })}\n</nav>\n\nApp() => <div>\n  <header class=\"top\">\n    <div>\n      <h1>Device Lab</h1>\n      <p class=\"sub\">{state.who}</p>\n    </div>\n    <div class=\"actions\">\n      <Btn label=\"Run every test\" tone=\"primary\" off={state.busy} go={runAll} />\n      <Btn label=\"Run the quiet tests\" off={state.busy} go={runQuiet} />\n    </div>\n  </header>\n\n  <PermChips />\n\n  <main class=\"grid\">\n    <Card title=\"Storage\" hint=\"Private to this app. No permission needed.\">\n      <div class=\"row\"><Text value={state.sKey} set={v => { state.sKey = v }} place=\"key\" /><Text value={state.sVal} set={v => { state.sVal = v }} place=\"value\" /></div>\n      <div class=\"row\"><Btn label=\"Set\" go={storageSet} /><Btn label=\"Get\" go={storageGet} /><Btn label=\"Remove\" go={storageRemove} /><Btn label=\"Keys\" go={storageKeys} /><Btn label=\"Clear\" tone=\"danger\" go={storageClear} /></div>\n      <Out id=\"storage\" />\n    </Card>\n\n    <Card title=\"Files\" hint=\"Permission: files. Saved in Documents, Apps, Device Lab (PitCode).\">\n      <div class=\"row\"><Text value={state.fName} set={v => { state.fName = v }} place=\"folder/name.txt\" /></div>\n      <textarea rows=\"4\" value={state.fText} onInput={e => { state.fText = e.target.value }}></textarea>\n      <div class=\"row\"><Btn label=\"Save\" go={filesSave} /><Btn label=\"Open\" go={filesOpen} /><Btn label=\"Delete\" go={filesDelete} /><Btn label=\"List folder\" go={filesList} /></div>\n      <div class=\"row\"><Text value={state.fDir} set={v => { state.fDir = v }} place=\"folder to list (empty = all)\" /></div>\n      <div class=\"files\">\n        {state.files.map(f => <button key={f.name} onClick={() => filesPick(f)}><span>{f.folder ? \"[folder] \" : \"\"}{f.name}</span><small>{f.folder ? \"\" : kb(f.size)}</small></button>)}\n      </div>\n      <Out id=\"files\" />\n    </Card>\n\n    <Card title=\"Notifications\" hint=\"Permission: notifications. They show while this app is open.\">\n      <div class=\"row\"><Text value={state.nTitle} set={v => { state.nTitle = v }} place=\"title\" /></div>\n      <div class=\"row\"><Text value={state.nBody} set={v => { state.nBody = v }} place=\"message\" /></div>\n      <div class=\"row\"><Btn label=\"Send now\" go={notifyNow} /><Btn label=\"Send in 5 seconds\" go={notifyLater} /><Btn label=\"Send 3\" go={notifyThree} /></div>\n      <Out id=\"notify\" />\n    </Card>\n\n    <Card title=\"Clipboard\" hint=\"Permission: clipboard.\">\n      <textarea rows=\"3\" value={state.cText} onInput={e => { state.cText = e.target.value }}></textarea>\n      <div class=\"row\"><Btn label=\"Copy this text\" go={clipCopy} /><Btn label=\"Paste from clipboard\" go={clipPaste} /></div>\n      <Out id=\"clip\" />\n    </Card>\n\n    <Card title=\"Camera\" hint=\"Permission: camera. One picture per press.\">\n      <div class=\"row\"><Btn label=\"Take a photo\" go={cameraSnap} /><Btn label=\"Save to files\" off={state.photo == nil} go={cameraSave} /><Btn label=\"Show saved photos\" go={galleryLoad} /></div>\n      {state.photo == nil ? nil : <img class=\"photo\" src={state.photo} alt=\"\" />}\n      <div class=\"gallery\">\n        {state.gallery.map(g => <img key={g.name} src={g.data} title={g.name} alt=\"\" onClick={() => { state.photo = g.data }} />)}\n      </div>\n      <Out id=\"camera\" />\n    </Card>\n\n    <Card title=\"Microphone\" hint=\"Permission: microphone. Records, then plays it back.\">\n      <div class=\"row\">\n        <select value={state.micSecs} onChange={e => { state.micSecs = e.target.value }}>\n          <option value=\"1000\">1 second</option>\n          <option value=\"3000\">3 seconds</option>\n          <option value=\"5000\">5 seconds</option>\n          <option value=\"10000\">10 seconds</option>\n        </select>\n        <Btn label=\"Record\" go={() => micRecord()} /><Btn label=\"Save to files\" off={state.audio == nil} go={micSave} />\n      </div>\n      <div class=\"meter\"><div style={{width: state.micPct + \"%\"}}></div></div>\n      {state.audio == nil ? nil : <audio controls src={state.audio}></audio>}\n      <Out id=\"mic\" />\n    </Card>\n\n    <Card title=\"Location\" hint=\"Permission: location.\">\n      <div class=\"row\"><Btn label=\"Where am I?\" go={locationGet} /><Btn label=\"Copy coordinates\" off={state.coords == nil} go={locationCopy} /><Btn label=\"Find the place name\" off={state.coords == nil} go={locationPlace} /></div>\n      {state.coords == nil ? nil : <div class=\"stat\">Latitude: {state.coords.lat.fixed(5)}   Longitude: {state.coords.lon.fixed(5)}   Accuracy: {math.round(state.coords.accuracy)} m</div>}\n      <Out id=\"loc\" />\n    </Card>\n\n    <Card wide={true} title=\"Internet\" hint=\"Permission: network. Only https addresses. Sites must allow being read by other pages (CORS).\">\n      <div class=\"row\"><Text value={state.uUrl} set={v => { state.uUrl = v }} place=\"https://...\" /><Btn label=\"GET\" go={netGet} /></div>\n      <div class=\"row\">\n        <Btn label=\"Random advice\" go={netZen} /><Btn label=\"My public address\" go={netIp} /><Btn label=\"Load a picture\" go={netPicture} /><Btn label=\"Speed test\" go={netSpeed} />\n        <span class={\"chip \" + (state.online ? \"ok\" : \"no\")}><i></i>{state.online ? \"Online\" : \"Offline\"}</span>\n      </div>\n      {state.picture == nil ? nil : <img class=\"photo\" src={state.picture} alt=\"\" />}\n      <Out id=\"net\" />\n    </Card>\n\n    <Card title=\"Window and theme\" hint=\"No permission needed.\">\n      <div class=\"row\"><Text value={state.wTitle} set={v => { state.wTitle = v }} place=\"title\" /><Btn label=\"Set the title\" go={windowTitle} /></div>\n      <div class=\"row\"><Btn label=\"Show info\" go={windowInfo} /><Btn label=\"Close this app\" tone=\"danger\" go={windowClose} /></div>\n      <div class=\"swatches\">\n        <div style={{background: state.theme.bg, color: state.theme.text}}>Background {state.theme.bg}</div>\n        <div style={{background: state.theme.text, color: state.theme.bg}}>Text {state.theme.text}</div>\n        <div style={{background: state.theme.accent, color: \"#ffffff\"}}>Accent {state.theme.accent}</div>\n      </div>\n      <Out id=\"win\" />\n    </Card>\n\n    <Card wide={true} title=\"Report\" hint=\"Every test result, newest last.\">\n      <div class=\"row\"><Btn label=\"Copy the report\" go={reportCopy} /><Btn label=\"Save it as a file\" go={reportSave} /><Btn label=\"Clear\" tone=\"danger\" go={reportClear} /></div>\n      <ol class=\"report\">\n        {state.report.map((r, i) => <li key={i} class={r.ok ? \"ok\" : \"no\"}>{r.ok ? \"Works: \" : \"Failed: \"}{r.name} <small>{r.at}{r.detail == \"\" ? \"\" : \" - \" + r.detail}</small></li>)}\n      </ol>\n    </Card>\n  </main>\n</div>\n\n// ----- start -----\nstart() => {\n  state.online = js.navigator.onLine\n  window.addEventListener(\"online\", () => { state.online = true })\n  window.addEventListener(\"offline\", () => { state.online = false })\n  js.patos.on(\"theme\", t => { state.theme = {bg: t.bg, text: t.text, accent: t.accent} })\n  pit info = wait js.patos.info()\n  state.theme = {bg: info.bg, text: info.text, accent: info.accent}\n  pit look = info.dark ? \"dark\" : \"light\"\n  pit lang = info.language == \"fr\" ? \"French\" : \"English\"\n  pit net = js.patos.app.network ? \"internet allowed\" : \"internet not allowed (or not asked yet)\"\n  state.who = \"{js.patos.app.name} {js.patos.app.version}  -  {look} theme, {lang}  -  {net}\"\n  pit opens = ((wait js.patos.storage.get(\"opens\")) ?? 0) + 1\n  js.patos.storage.set(\"opens\", opens)\n  put(\"storage\", \"You have opened Device Lab {opens} time(s).\")\n  js.patos.log(\"Device Lab started.\", false)\n}\n\ndraw(App)\nstart()\n",
    "styles.pitoss": "// Device Lab (PitCode): the look. The colors follow the system through --patos-bg, --patos-text and --patos-accent.\n\npit soft = \"color-mix(in srgb, var(--patos-text) 6%, transparent)\"\npit line = \"color-mix(in srgb, var(--patos-text) 12%, transparent)\"\npit fill = \"color-mix(in srgb, var(--patos-text) 14%, transparent)\"\n\nstyle * {\n  box-sizing: border-box\n}\n\nstyle body {\n  padding: 14 16 40\n  max-width: 1100\n  margin: 0 auto\n}\n\nstyle h1 {\n  margin: 0\n  font-size: 24\n}\n\nstyle h2 {\n  margin: 0 0 2\n  font-size: 16\n}\n\nstyle .sub {\n  margin: 2 0 0\n  opacity: 0.7\n  font-size: 12.5\n}\n\nstyle .top {\n  display: flex\n  arrange: space-between\n  align: center\n  gap: 12\n  wrap: wrap\n  margin-bottom: 12\n}\n\nstyle .actions {\n  display: flex\n  gap: 8\n  wrap: wrap\n}\n\nstyle .perms {\n  display: flex\n  gap: 6\n  wrap: wrap\n  margin-bottom: 14\n}\n\nstyle .chip {\n  display: inline-flex\n  align: center\n  gap: 6\n  padding: 4 10\n  corners: 14\n  font-size: 12\n  background: {fill}\n\n  style i {\n    width: 8\n    height: 8\n    corners: 50%\n    background: #8e8e93\n    display: inline-block\n  }\n\n  style &.ok i {\n    background: #34c759\n  }\n\n  style &.no i {\n    background: #ff453a\n  }\n\n  style &.warn i {\n    background: #ff9f0a\n  }\n}\n\nstyle .grid {\n  display: grid\n  column-sizes: repeat(auto-fill, minmax(320px, 1fr))\n  gap: 12\n}\n\nstyle .card {\n  padding: 12 14 14\n  corners: 14\n  background: {soft}\n  border: 1 solid {line}\n  display: flex\n  flow: column\n  gap: 8\n  min-width: 0\n}\n\nstyle .card.wide {\n  grid-column: 1 / -1\n}\n\nstyle .hint {\n  margin: 0\n  opacity: 0.65\n  font-size: 12\n}\n\nstyle .row {\n  display: flex\n  gap: 6\n  wrap: wrap\n  align: center\n\n  style input, select {\n    flex: 1\n    min-width: 110\n  }\n}\n\nstyle input, textarea, select {\n  font: inherit\n  text-color: inherit\n  padding: 7 9\n  corners: 8\n  border: 1 solid {line}\n  background: transparent\n  width: 100%\n}\n\nstyle textarea {\n  resize: vertical\n}\n\nstyle .btn {\n  font: inherit\n  padding: 7 13\n  corners: 8\n  border: 0\n  cursor: hand\n  text-color: var(--patos-text)\n  background: {fill}\n\n  style &.primary {\n    background: var(--patos-accent)\n    text-color: #ffffff\n  }\n\n  style &.danger {\n    text-color: #ff453a\n  }\n\n  style &:disabled {\n    opacity: 0.4\n    cursor: default\n  }\n}\n\nstyle .out {\n  margin: 0\n  min-height: 18\n  max-height: 190\n  overflow: auto\n  white-space: pre-wrap\n  word-break: break-word\n  font: 12 / 1.45 ui-monospace, Menlo, Consolas, monospace\n  opacity: 0.9\n\n  style &.err {\n    text-color: #ff453a\n  }\n\n  style &.ok {\n    text-color: #30b350\n  }\n}\n\nstyle .photo {\n  max-width: 100%\n  corners: 10\n  display: block\n}\n\nstyle .gallery {\n  display: flex\n  gap: 6\n  wrap: wrap\n\n  style img {\n    width: 64\n    height: 64\n    fit: cover\n    corners: 8\n    cursor: hand\n  }\n}\n\nstyle .files {\n  display: flex\n  flow: column\n  gap: 3\n\n  style button {\n    text-align: left\n    font: inherit\n    padding: 5 8\n    border: 0\n    corners: 6\n    background: {soft}\n    text-color: inherit\n    cursor: hand\n    display: flex\n    arrange: space-between\n    gap: 8\n  }\n}\n\nstyle .meter {\n  height: 8\n  corners: 4\n  background: {line}\n  overflow: hidden\n\n  style div {\n    height: 100%\n    background: var(--patos-accent)\n    transition: width 0.2s linear\n  }\n}\n\nstyle .stat {\n  font-size: 13\n}\n\nstyle .swatches {\n  display: flex\n  gap: 8\n\n  style div {\n    flex: 1\n    height: 36\n    corners: 8\n    font-size: 11\n    display: grid\n    place-items: center\n    border: 1 solid {line}\n  }\n}\n\nstyle .report {\n  margin: 0\n  padding-left: 22\n  display: flex\n  flow: column\n  gap: 3\n  font-size: 13\n\n  style small {\n    opacity: 0.65\n  }\n}\n",
    "tools.pit": "// Device Lab (PitCode): the shared state and the small helpers the other files use.\n\nshare lock PERMS = [\"files\", \"notifications\", \"clipboard\", \"camera\", \"microphone\", \"location\", \"network\"]\nshare lock LABELS = {files: \"Files\", notifications: \"Notifications\", clipboard: \"Clipboard\", camera: \"Camera\", microphone: \"Microphone\", location: \"Location\", network: \"Internet\"}\n\n// Everything the screen shows lives here. Changing a key draws the page again.\nshare lock state = store({\n  perms: {},          // what each permission did: \"ok\" or \"no\"\n  report: [],         // every test result\n  outs: {},           // the text under each card\n  sKey: \"color\", sVal: \"blue\",\n  fName: \"lab/hello.txt\", fText: \"Hello from Device Lab\", fDir: \"\", files: [],\n  nTitle: \"Device Lab\", nBody: \"This is a test notification.\", nCount: 0,\n  cText: \"Copied by Device Lab\",\n  photo: nil, gallery: [],\n  micSecs: \"3000\", micPct: 0, audio: nil,\n  coords: nil, place: \"\",\n  uUrl: \"https://api.github.com/zen\", picture: nil, online: true,\n  wTitle: \"Device Lab - testing\", theme: {bg: \"#1c1c1e\", text: \"#f2f2f7\", accent: \"#0a84ff\"},\n  who: \"\", busy: false\n})\n\n// PASS or FAIL, for the report and the console.\nshare verdict(ok) => ok ? \"PASS\" : \"FAIL\"\n\nshare kb(bytes) => \"{(bytes / 1024).fixed(1)} KB\"\nshare stamp() => time.format(time.now(), \"HH:mm:ss\")\n\n// Write the text (and its color: \"ok\", \"err\" or \"\") under a card.\nshare put(card, text, tone = \"\") => {\n  pit all = copy(state.outs)\n  all[card] = {text: text, tone: tone}\n  state.outs = all\n}\n\nshare markPerm(perm, status) => {\n  pit all = copy(state.perms)\n  all[perm] = status\n  state.perms = all\n}\n\n// Add a line to the report (and to the Studio console).\nshare note(name, ok, detail = \"\") => {\n  state.report = [...state.report, {name: name, ok: ok, detail: detail, at: stamp()}]\n  js.patos.log(\"{verdict(ok)} {name} {detail}\", not ok)\n}\n\n// Run one thing, write down how it went, and note whether the permission was given or refused.\n// The error is raised again so the card can show it.\nshare track(perm, name, task) => {\n  attempt {\n    pit value = wait task()\n    when perm != nil { markPerm(perm, \"ok\") }\n    note(name, true)\n    back value\n  } rescue e {\n    pit msg = text(e.message)\n    when perm != nil and (\"did not allow\" in msg or \"did not ask\" in msg) { markPerm(perm, \"no\") }\n    note(name, false, msg)\n    raise e\n  }\n}\n\nshare reportText() => {\n  pit lines = state.report.map(r => \"{verdict(r.ok)} {r.name} {r.detail}\")\n  back \"Device Lab report {stamp()}\\n\" + lines.join(\"\\n\")\n}\n"
  }
