{
  "id": "./",
  "name": "PatOS",
  "short_name": "PatOS",
  "description": "A desktop operating system that runs in your browser.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#0b0b14",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Finder", "url": "./?app=finder", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Docs", "url": "./?app=docs", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notes", "url": "./?app=notes", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Code Studio", "url": "./?app=code", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "file_handlers": [
    {
      "action": "./?open=files",
      "accept": {
        "text/plain": [".txt", ".md", ".log", ".py", ".js", ".css", ".json", ".csv"],
        "text/html": [".html", ".htm"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/pdf": [".pdf"],
        "application/zip": [".zip"],
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"],
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a"],
        "video/*": [".mp4", ".webm", ".mov"]
      }
    }
  ]
}
