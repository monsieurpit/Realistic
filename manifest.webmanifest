{
  "name": "PatOS",
  "short_name": "PatOS",
  "description": "A desktop operating system that runs in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#000000",
  "theme_color": "#0b0b14",
  "icons": [{ "src": "assets/icon-180.png", "sizes": "180x180", "type": "image/png" }, { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }]
}
